{
  "name": "bulk-message-whatsapp",
  "version": "1.0.0",
  "description": "Desktop app untuk mengirim pesan WhatsApp massal dari tabel atau file Excel",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "build": "tsc --noEmit && electron-vite build",
    "build:installer": "npm run build && electron-builder --win nsis --x64",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "start:cli": "node cli/index.js",
    "send:excel": "node cli/excelsendwamessage.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "build": {
    "appId": "id.bulkmessagewhatsapp.desktop",
    "productName": "Bulk WhatsApp",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "assets/bulk-wa.png",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "assets/bulk-wa.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "${productName}-Setup-${version}-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "installerIcon": "assets/bulk-wa.ico",
      "uninstallerIcon": "assets/bulk-wa.ico",
      "installerHeaderIcon": "assets/bulk-wa.ico",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "dependencies": {
    "@hapi/boom": "^10.0.1",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.68.0",
    "open-windows-file-dialog": "^1.0.0",
    "pino": "^10.3.1",
    "qrcode": "^1.5.4",
    "qrcode-terminal": "^0.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "^1.4.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^33.4.11",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  }
}
